# Salin menjadi .env, lalu isi kredensial login.
# File .env TIDAK boleh di-commit dan sebaiknya permission 600:
#   chmod 600 .env
#
# WAJIB: username + password login hanya dibaca dari .env.
# Isi ADMIN_PASSWORD, atau ADMIN_PASSWORD_HASH sebagai alternatif.
# Jika username kosong / password & hash kosong, container sengaja berhenti.
# Password dengan spasi/#/$ sebaiknya dibungkus kutip tunggal, contoh:
#   ADMIN_PASSWORD='password saya #1'
# Atau gunakan ADMIN_PASSWORD_HASH (paling aman).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Alternatif lebih aman: isi hash dan kosongkan ADMIN_PASSWORD.
# Buat dengan: python server.py --hash-password
# ADMIN_PASSWORD_HASH=pbkdf2_sha256:260000:xxxx:xxxx

# HTTPS:
# - Akses selalu lewat domain HTTPS dari NPM (Force SSL ON).
# - COOKIE_SECURE=auto membuat cookie Secure otomatis saat request HTTPS.
# - Isi PUBLIC_ORIGIN dengan origin HTTPS kamu (opsional tapi disarankan).
PUBLIC_ORIGIN=
COOKIE_SECURE=auto

# Token internal. Kosongkan agar dibuat otomatis dan disimpan permanen
# di volume data (/app/data). Boleh juga diisi manual lewat .env.
# JWT_SECRET minimal 32 karakter. OVERLAY_TOKEN minimal 16 karakter.
JWT_SECRET=
OVERLAY_TOKEN=
JWT_EXPIRE_HOURS=12

# Rate limit login per IP dan per IP+username.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Rate limit API dan WebSocket per IP.
API_RATE_LIMIT=180
API_RATE_WINDOW_SECONDS=60
WS_RATE_LIMIT=60
MAX_WS_CLIENTS=100

# Opsional: auto-start bot saat container hidup.
DEFAULT_USERNAME=
